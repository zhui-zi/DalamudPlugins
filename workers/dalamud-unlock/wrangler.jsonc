{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dalamud-unlock",
  "main": "src/index.js",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "dalamudunlock.ff14.cafe",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
