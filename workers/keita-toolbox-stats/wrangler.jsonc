{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keita-toolbox-stats",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-16",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "pluginping.keita.cc",
      "custom_domain": true
    },
    {
      "pattern": "pluginstats.keita.cc",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "keita-toolbox-stats",
      "database_id": "b5e534ce-fe6d-4eec-a16e-297607aaba7c",
      "migrations_dir": "migrations"
    }
  ]
}
